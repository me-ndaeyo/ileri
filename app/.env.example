# Copy to .env.local, which is gitignored. Names only here, never values.

# --- public: these reach the browser, so nothing secret belongs here ---
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=ileri.testnet
NEXT_PUBLIC_TOKEN_ID=usdc.ileri.testnet
# Optional. The public RPC drops requests under load; point this at a dedicated
# endpoint before recording the demo.
NEXT_PUBLIC_RPC_URL=

# --- server only: never prefixed NEXT_PUBLIC, never logged ---
# Postgres. Neon's free tier is enough.
DATABASE_URL=
# AES-256-GCM key for invoice files at rest. Generate with:
#   openssl rand -base64 32
FILE_ENC_KEY=
# Signs the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
# 1Click partner token, from partners.near-intents.org. Without it there is a 0.2% fee.
ONECLICK_JWT=
# Which cross-chain delivery route to use. `native` has 1Click deliver straight into the
# contract with the invoice id attached, which is the better story and is marked highly
# experimental upstream. `relay` has it deliver to RELAYER_ACCOUNT_ID, which then calls
# ft_transfer_call itself: briefly custodial, and the fallback if native does not hold.
# Defaults to native. Everything except the final hop is identical between them.
PAY_ROUTE=native
# Pays gas for NEP-366 delegate actions. A separate account from the sponsor,
# holding at most 2 NEAR.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Tops up brand new client accounts so they can afford the mint storage deposit.
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
